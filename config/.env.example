# ============================================================
# No SOC for Mom — environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# --- n8n instance ---
N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_WEBHOOK_SECRET=change-me

# --- LLM (triage agents) ---
ANTHROPIC_API_KEY=sk-ant-...
# Tier 1: fast/cheap classification
TIER1_MODEL=claude-haiku-4-5-20251001
# Tier 2: ambiguous case analysis
TIER2_MODEL=claude-sonnet-5
# Tier 3: sophisticated threat escalation
TIER3_MODEL=claude-opus-4-8

# --- Enrichment sources (free tiers) ---
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=

# --- Intake channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=   # comma-separated; only family chats get answers
